[binaries]
c = 'riscv64-linux-gnu-gcc'
cpp = 'riscv64-linux-gnu-g++'
ar = 'riscv64-linux-gnu-ar'
pkg-config = 'pkg-config'
pcap-config = ''

[host_machine]
system = 'linux'
cpu_family = 'riscv64'
cpu = 'riscv64'
endian = 'little'

[properties]
platform = 'generic_riscv64'
sys_root = '/usr/riscv64-linux-gnu'
needs_exe_wrapper = false

[built-in options]
c_args = ['-march=rv64gc', '-mabi=lp64d', '-g', '-O0']
cpp_args = ['-march=rv64gc', '-mabi=lp64d', '-g', '-O0']
